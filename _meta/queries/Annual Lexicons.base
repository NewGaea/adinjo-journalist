filters:
  and:
    - file.path.startsWith("lexicon")
    - '!file.name.startsWith("_")'
    - file.ext == "md"
    - "!englishGloss.isEmpty()"
views:
  - type: table
    name: Annual 1998
    filters:
      and:
        - coinDate >= "1998-01-01"
        - coinDate <= "1998-12-31"
    order:
      - file.name
      - englishGloss
      - coinDate
  - type: table
    name: Annual 1999
    filters:
      and:
        - coinDate >= "1999-01-01"
        - coinDate <= "1999-12-31"
    order:
      - file.name
      - englishGloss
      - coinDate
